{
  "name": "FaceUnity-Nama",
  "id": "FaceUnity-Nama",
  "version": "1.2.1",
  "description": "FaceUnity CNama SDK",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "integrateType": "aar",
      "plugins": [
        {
          "type": "module",
          "name": "FaceUnity-Nama",
          "class": "com.faceunity.nama.NamaModule"
        }
      ],
      "abis": [
        "armeabi-v7a",
        "arm64-v8a"
      ],
      "minSdkVersion": "21"
    },
    "ios": {
      "integrateType": "framework",
      "plugins": [
        {
          "type": "module",
          "name": "FaceUnity-Nama",
          "class": "NamaModule"
        }
      ],
      "deploymentTarget": "11.0",
      "validArchitectures": [
        "arm64"
      ],
      "frameworks": [
        "FaceUnityNama.framework",
        "FURenderKit.framework",
        "GLKit.framework",
        "OpenGLES.framework",
        "Accelerate.framework",
        "CoreMedia.framework",
        "AVFoundation.framework",
        "CoreVideo.framework",
        "CoreML.framework",
        "Photos.framework",
        "UIKit.framework",
        "Foundation.framework",
        "WebKit.framework",
        "AudioToolbox.framework",
        "CoreImage.framework",
        "CoreMotion.framework",
        "ImageIO.framework",
        "Metal.framework",
        "QuartzCore.framework"
      ],
      "embedFrameworks": [
        "FaceUnityNama.framework",
        "FURenderKit.framework"
      ],
      "privacies": [
        "NSCameraUsageDescription",
        "NSMicrophoneUsageDescription",
        "NSPhotoLibraryUsageDescription",
        "NSPhotoLibraryAddUsageDescription"
      ]
    }
  }
}
